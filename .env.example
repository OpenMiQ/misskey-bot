# The Misskey instance to connect to, e.g. https://misskey.example
# (no trailing slash).
MISSKEY_URL=

# The bot account's access token. Needs: read:account, write:notes,
# read:notifications, write:notifications, write:reactions, read:drive,
# write:drive. Generate one from the account's Settings -> API, or via
# MiAuth.
MISSKEY_TOKEN=

# Comma-separated Misskey user IDs allowed to run the "admin"/"host-settings"
# text commands.
ADMIN_IDS=

# Locale used when no user/host/bot default is set. Must be a supported locale code (en, ja).
DEFAULT_LOCALE=en

# Where per-user/host/bot settings are stored as JSON. Defaults to ./data.
DATA_DIR=

# If set, also save a copy of every generated image to this directory.
# Disabled by default.
SAVE_IMAGES_DIR=

# Path to the bot's logo image, drawn as the quote watermark in place of
# the bot's own handle. Unset by default — the watermark stays the handle.
LOGO_PATH=

# Process name pm2 registers the bot under (see ecosystem.config.cjs).
# Defaults to "openmiq-misskey".
PM2_APP_NAME=
